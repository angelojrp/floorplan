{
  "name": "@angelojrp/floorplan",
  "version": "1.0.0",
  "description": "Text-to-floorplan renderer — descreva plantas baixas em YAML e renderize como SVG",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "floorplan": "./dist/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:worker": "wrangler deploy --config api/wrangler.toml",
    "prepublishOnly": "npm run build:lib",
    "prepare": "npm run build:lib",
    "db:migrate": "wrangler d1 migrations apply floorplan --config api/wrangler.toml --remote",
    "db:migrate:local": "wrangler d1 migrations apply floorplan --config api/wrangler.toml --local"
  },
  "keywords": [
    "floorplan",
    "plant-baixa",
    "svg",
    "construction",
    "mermaid",
    "dxf",
    "yaml",
    "architecture"
  ],
  "files": [
    "dist/",
    "docs/AI_GUIDE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/angelojrp/floorplan"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "commander": "^12.1.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wrangler": "^4.129.0"
  }
}
