# Front (Vite) — sem estas, o login fica DESLIGADO e o site funciona
# exatamente como antes: anônimo, com autosave no localStorage.
VITE_CLERK_PUBLISHABLE_KEY=
# Base da API. Vazio = mesma origem (Worker roteado em /api).
VITE_API_BASE=

# Worker — definidos com:
#   wrangler secret put <NOME> --config api/wrangler.toml
# Em dev local, num api/.dev.vars (não versionado).
#   CLERK_SECRET_KEY=sk_test_...
#   CLERK_PUBLISHABLE_KEY=pk_test_...
#   CLERK_AUTHORIZED_PARTIES=https://construtora.ai,http://localhost:5173
#   IP_HASH_SECRET=<aleatório longo>
